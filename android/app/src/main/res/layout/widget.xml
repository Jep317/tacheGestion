<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fond_widget"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Onglets : la liste des tâches ou les notes et idées. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/onglet_taches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp"
                android:text="Tâches"
                android:textColor="@color/texte"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/onglet_notes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp"
                android:text="Notes"
                android:textColor="@color/discret"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/etat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/discret"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btn_actualiser"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="Actualiser"
            android:src="@drawable/ic_actualiser" />

        <ImageButton
            android:id="@+id/btn_courses"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/fond_bouton"
            android:contentDescription="Liste de courses"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_courses" />

        <ImageButton
            android:id="@+id/btn_dicter"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/fond_bouton"
            android:contentDescription="Dicter"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_micro" />

        <ImageButton
            android:id="@+id/btn_ajouter"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/fond_bouton"
            android:contentDescription="Ajouter"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ajouter" />
    </LinearLayout>

    <!-- Filtre comme sur PC : une pastille Catégorie et une pastille Sujet (toucher pour choisir), mémorisé par widget. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/filtre_cat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/fond_filtre"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="150dp"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:text="Catégorie ▾"
            android:textColor="@color/texte"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/filtre_sujet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/fond_filtre"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="150dp"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:text="Sujet ▾"
            android:textColor="@color/texte"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/filtre_effacer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:contentDescription="Tout voir"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:minWidth="40dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/discret"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/liste"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/vide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Chargement…"
            android:textColor="@color/discret"
            android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
