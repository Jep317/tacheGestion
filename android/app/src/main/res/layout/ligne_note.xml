<?xml version="1.0" encoding="utf-8"?>
<!-- Une note dans le widget : comme un article (titre en serif, deux lignes d'aperçu, temps de lecture). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ligne"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fond_ligne"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingTop="12dp"
    android:paddingEnd="4dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/titre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="2"
        android:textColor="@color/texte"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/extrait"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="2"
        android:textColor="@color/discret"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/discret"
        android:textSize="12sp" />
</LinearLayout>
