<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Taches" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/fond</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/fond</item>
        <item name="android:textColorPrimary">@color/texte</item>
    </style>
    <style name="Theme.Taches.Fenetre" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Theme.Taches.Transparent" parent="@android:style/Theme.Translucent.NoTitleBar" />
    <!-- Fiche d'une tâche ouverte depuis le widget : panneau arrondi qui monte du bas de l'écran. -->
    <style name="Theme.Taches.Fiche" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/fond_fiche</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:textColorPrimary">@color/texte</item>
        <item name="android:alertDialogTheme">@android:style/Theme.Material.Dialog.Alert</item>
    </style>
</resources>
